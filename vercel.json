{
  "version": 2,
  "framework": null,
  "buildCommand": "echo ok",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60
    }
  },
  "builds": [
    {
      "src": "api/index.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.ts"
    }
  ]
}
